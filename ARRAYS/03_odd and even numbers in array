#include <iostream>
using namespace std;
int main() {
	int n;
	cout<<"Size of array = ";
	cin>>n;
	int arr[n];
	for (int i= 0 ; i<n ; i++) {
		cout<<"Enter Array elements ";
		cin>>arr[i];
	}
	for (int i = 0; i < n ; i++) {
		cout<<arr[i]<<" ";
	}
	int counteven = 0;
	int countodd = 0;
	cout<<endl;

	for (int i = 0; i < n ; i++) {
		if (arr[i] % 2==0 ) {
            cout<<arr[i]<<" is even "<<endl;
			counteven++;
		} else {           
            cout<<arr[i]<<" is odd "<<endl;
			countodd++;
		}

	}
	cout<<"Even numbers = "<<counteven<<endl;
	cout<<"odd numbers= "<<countodd<<endl;
	return 0;
}
